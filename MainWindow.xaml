<Window x:Class="memoriaJatek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:memoriaJatek"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="800">
    <Grid x:Name="grd_main">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="lstbox_size" Grid.Row="0" SelectionChanged="lstbox_size_SelectionChanged"></ListBox>
        <Grid x:Name="grd_game" Grid.Row="1"> </Grid>
    </Grid>
</Window>
